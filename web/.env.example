# Copy to .env.local (gitignored) and fill in with the deployed
# PoplaBackendStack's CfnOutputs (ApiUrl, UserPoolId, UserPoolClientId).
VITE_APPSYNC_URL=
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Optional — 'true' to show SMS-OTP sign-in ("Forgot your password?" on the
# login page). Off by default: admin-issued temporary passwords (see the
# Participants page) are the primary reset path.
VITE_FEATURE_SMS_OTP=
