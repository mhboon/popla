# Copy to .env.local (gitignored) and fill in with the deployed
# PoplaBackendStack's CfnOutputs (ApiUrl, UserPoolId, UserPoolClientId).
VITE_APPSYNC_URL=
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Optional — 'true' to show the admin password-reset action. Requires the
# backend to also be deployed with -c enableAdminPasswordReset=true.
VITE_FEATURE_ADMIN_PASSWORD_RESET=
