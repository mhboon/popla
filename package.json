{
  "name": "popla",
  "private": true,
  "workspaces": [
    "infra",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "infra/**/*.ts": [
      "eslint --fix --config infra/eslint.config.mjs"
    ],
    "web/**/*.{ts,tsx}": [
      "eslint --fix --config web/eslint.config.mjs"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
