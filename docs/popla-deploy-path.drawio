        <mxCell id="step-1-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;Prove identity, no keys&lt;/b&gt; — on merge to main, the Actions runner exchanges a short-lived OIDC token with AWS STS. No AWS access key is ever stored in the repo or as a secret.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-1-legend">
          <mxGeometry height="90" width="480" x="52" as="geometry" />
        </mxCell>

